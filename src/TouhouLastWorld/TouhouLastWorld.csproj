<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildProjectDirectory)/../../.local/core</BepInExCore>
    <InteropDir Condition="'$(InteropDir)' == ''">$(MSBuildProjectDirectory)/../../.local/interop</InteropDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TouhouLastWorld.Core/TouhouLastWorld.Core.csproj" Condition="'$(BundleSources)' != 'true'" />
    <ProjectReference Include="../TouhouLastWorld.Storage/TouhouLastWorld.Storage.csproj" Condition="'$(BundleSources)' != 'true'" />
    <ProjectReference Include="../TouhouLastWorld.Protocol/TouhouLastWorld.Protocol.csproj" Condition="'$(BundleSources)' != 'true'" />
    <EmbeddedResource Include="user-seed.json" />
    <ProjectReference Include="../TouhouLastWorld.Generators/TouhouLastWorld.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Reference Include="$(InteropDir)/*.dll" Private="false" />
    <Reference Include="$(BepInExCore)/BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExCore)/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)/0Harmony.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundleSources)' == 'true'">
    <Compile Include="../TouhouLastWorld.Core/**/*.cs;../TouhouLastWorld.Storage/**/*.cs;../TouhouLastWorld.Protocol/**/*.cs"
             Exclude="../*/obj/**/*.cs;../*/bin/**/*.cs;../TouhouLastWorld.Core/Properties/**/*.cs" />
  </ItemGroup>
</Project>
