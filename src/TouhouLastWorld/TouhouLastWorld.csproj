<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildProjectDirectory)/../../.local/core</BepInExCore>
    <InteropDir Condition="'$(InteropDir)' == ''">$(MSBuildProjectDirectory)/../../.local/interop</InteropDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TouhouLastWorld.Core/TouhouLastWorld.Core.csproj" Condition="'$(BundleSources)' != 'true'" />
    <ProjectReference Include="../TouhouLastWorld.Storage/TouhouLastWorld.Storage.csproj" Condition="'$(BundleSources)' != 'true'" />
    <ProjectReference Include="../TouhouLastWorld.Protocol/TouhouLastWorld.Protocol.csproj" Condition="'$(BundleSources)' != 'true'" />
    <EmbeddedResource Include="user-seed.json" />
    <ProjectReference Include="../TouhouLastWorld.Generators/TouhouLastWorld.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Reference Include="$(InteropDir)/*.dll" Private="false" />
    <Reference Include="$(BepInExCore)/BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExCore)/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)/0Harmony.dll" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundleSources)' == 'true'">
    <Compile Include="../TouhouLastWorld.Core/**/*.cs;../TouhouLastWorld.Storage/**/*.cs;../TouhouLastWorld.Protocol/**/*.cs"
             Exclude="../*/obj/**/*.cs;../*/bin/**/*.cs;../TouhouLastWorld.Core/Properties/**/*.cs" />
  </ItemGroup>
  <Target Name="GeneratePluginBuildInfo" BeforeTargets="BeforeCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)PluginBuildInfo.g.cs"
                      Lines="namespace TouhouLastWorld { internal static class PluginBuildInfo { internal const string Id = &quot;$(PluginId)&quot;%3B internal const string Name = &quot;$(PluginName)&quot;%3B internal const string Version = &quot;$(Version)&quot;%3B } }"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)PluginBuildInfo.g.cs" />
    </ItemGroup>
  </Target>
  <Target Name="PackageVersionedPlugin" AfterTargets="Build">
    <PropertyGroup>
      <DistributionDirectory Condition="'$(DistributionDirectory)' == '' and '$(BundleSources)' == 'true'">$(MSBuildProjectDirectory)/../../deliveries/$(Version)</DistributionDirectory>
      <DistributionDirectory Condition="'$(DistributionDirectory)' == ''">$(TargetDir)distribution</DistributionDirectory>
      <VersionedPluginPath>$(DistributionDirectory)/$(AssemblyName)-v$(Version)$(TargetExt)</VersionedPluginPath>
    </PropertyGroup>
    <MakeDir Directories="$(DistributionDirectory)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(VersionedPluginPath)" SkipUnchangedFiles="true" />
    <ItemGroup Condition="'$(BundleSources)' != 'true'">
      <DistributionDependencies Include="$(TargetDir)TouhouLastWorld.Core.dll;$(TargetDir)TouhouLastWorld.Storage.dll;$(TargetDir)TouhouLastWorld.Protocol.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DistributionDependencies)" DestinationFolder="$(DistributionDirectory)" SkipUnchangedFiles="true" Condition="'@(DistributionDependencies)' != ''" />
    <Message Text="Plugin delivery: $(VersionedPluginPath)" Importance="High" />
  </Target>
</Project>
